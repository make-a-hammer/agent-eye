    {
      "id": "agenteye-proactive-001",
      "kind": "proactive",
      "signature": {
        "stage": "preflight",
        "errorCode": "PROXY_PREFLIGHT",
        "messagePattern": "目标 URL 为海外域名（github/google/youtube 等）",
        "fileContext": "*"
      },
      "rootCause": "直连海外源必超时，先探代理再导航可省一次失败循环。",
      "tags": ["proactive", "proxy", "preflight"],
      "fix": {
        "type": "behavior",
        "description": "导航前先 socket 探测代理；目标为海外域名且代理不可用则直接提示，不空跑导航。",
        "actions": [
          {"action": "check_proxy", "detail": "导航前预检代理状态"}
        ]
      },
      "occurrences": 0,
      "contributingProjects": [],

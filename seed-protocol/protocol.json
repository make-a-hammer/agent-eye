    {
      "id": "agenteye-proactive-002",
      "kind": "proactive",
      "signature": {
        "stage": "preflight",
        "errorCode": "THROTTLE_PREFLIGHT",
        "messagePattern": "连续操作间隔小于 2s",
        "fileContext": "*"
      },
      "rootCause": "频率过快是 429/验证码的首要诱因，节流应在动作前而非动作后。",
      "tags": ["proactive", "throttle", "compliance"],
      "fix": {
        "type": "behavior",
        "description": "确认每个动作前都经过 ethics.throttle.wait()，避免连发。",
        "actions": [
          {"action": "throttle_up", "detail": "动作前强制节流"}
        ]
      },
